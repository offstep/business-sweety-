# Copie ce fichier en ".env" pour le développement local (ne jamais committer .env).
# Mêmes valeurs que NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY de ton ancien .env.local.
# Uniquement la clé publique (anon / publishable). JAMAIS la clé service_role.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Nom du bucket Supabase Storage utilisé par l'admin pour les photos (à vérifier dans ton projet).
VITE_STORAGE_BUCKET=images
